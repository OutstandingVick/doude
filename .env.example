# Feasibility3D — environment variables
#
# Copy to `.env` (repo root) for `docker compose`, or export them on the host.
# Values marked (required) make `docker compose` fail fast if missing.

# --- Environment ----------------------------------------------------------
# "production" makes the engine refuse to start unless COOKIE_SECRET and
# ADMIN_PASSWORD are set. Open mode (no login, no COOKIE_SECRET) is only
# allowed with APP_ENV=development.
APP_ENV=production

# --- Authentication -------------------------------------------------------
# Secret used to sign session cookies. (required) Use a long random string,
# e.g. `openssl rand -hex 32`. Changing it logs everyone out.
COOKIE_SECRET=change-me-please

# First-admin bootstrap: on a fresh database the engine creates this account
# at startup. (required) After the first admin exists these are ignored.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Cookies --------------------------------------------------------------
# The browser only talks to the app's own origin (/api/* is proxied to the
# engine), so the session cookie is first-party: SameSite=Lax, Secure.
# Set to "false" only for plain-http local testing (http://localhost).
COOKIE_SECURE=true

# --- Networking -----------------------------------------------------------
# Server-side URL the app's /api proxy forwards to. docker compose sets this
# to http://engine:8000 for you; set it yourself when the engine runs
# elsewhere (e.g. https://your-engine.onrender.com). Never exposed to the
# browser.
#ENGINE_URL=http://engine:8000

# --- Data paths (optional) -----------------------------------------------
# docker-compose already points these at the /data volume. Override only if
# you run the engine outside compose.
#FEASIBILITY3D_DB=/data/feasibility3d.db
#FEASIBILITY3D_EVIDENCE=/data/evidence
#FEASIBILITY3D_REPORTS=/data/reports
