# Feasibility3D — environment variables
#
# Copy to `.env` (repo root) for `docker compose`, or export them on the host.
# Values marked (required) make `docker compose` fail fast if missing.

# --- Authentication -------------------------------------------------------
# Secret used to sign session cookies. (required) Use a long random string,
# e.g. `openssl rand -hex 32`. Changing it logs everyone out.
COOKIE_SECRET=change-me-please

# First-admin bootstrap: on a fresh database the engine creates this account
# at startup. (required) After the first admin exists these are ignored.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Cookies --------------------------------------------------------------
# "true" when the app is served over HTTPS (production); "false" for local
# http://localhost. Secure cookies are rejected by browsers over plain http.
COOKIE_SECURE=false
# "lax" for local / same-site; "none" for cross-site production (needs
# COOKIE_SECURE=true). See DEPLOY.md.
COOKIE_SAMESITE=lax

# --- Networking -----------------------------------------------------------
# Comma-separated list of browser origins allowed to call the engine API
# (CORS). Must include the origin the app is served from.
CORS_ORIGINS=http://localhost:3000

# Base URL of the engine as reached by the BROWSER. Baked into the app at
# build time (Next.js NEXT_PUBLIC_* vars are compile-time). For local compose
# this is http://localhost:8000; in production use your public engine URL
# (e.g. https://your-domain/api behind a reverse proxy).
NEXT_PUBLIC_FEASIBILITY3D_API=http://localhost:8000

# --- Data paths (optional) -----------------------------------------------
# docker-compose already points these at the /data volume. Override only if
# you run the engine outside compose.
#FEASIBILITY3D_DB=/data/feasibility3d.db
#FEASIBILITY3D_EVIDENCE=/data/evidence
#FEASIBILITY3D_REPORTS=/data/reports
