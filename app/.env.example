# Feasibility3D app (Next.js) environment variables
#
# The browser always calls /api/* on the app's own origin; Next proxies those
# requests to ENGINE_URL. ENGINE_URL is server-side only (never sent to the
# browser). Rewrites are resolved when the app is built, so set it at build
# time (and keep it set at runtime).
#
# - Local dev:            http://localhost:8000
# - docker compose:       http://engine:8000
# - Render engine:        https://your-engine.onrender.com
ENGINE_URL=http://localhost:8000
