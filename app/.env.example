# Feasibility3D app (Next.js) environment variables
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# changing them requires a rebuild/redeploy.

# Base URL of the engine API as reached by the browser.
# - Local / docker compose: http://localhost:8000
# - Render (engine) + Vercel (app): https://your-engine.onrender.com
# - Same-domain reverse proxy: https://your-domain/api
# Must also be listed in the engine's CORS_ORIGINS (the app's origin).
NEXT_PUBLIC_FEASIBILITY3D_API=http://localhost:8000
